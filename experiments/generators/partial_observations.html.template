<!doctype html>
<html lang="en"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Partial observations · SkellyForge</title>
<style>
body{background:#101720;color:#e1e8f0;font:16px system-ui;margin:24px auto;max-width:1280px;padding:0 20px}h1{font-size:26px;margin-bottom:6px}p{color:#acbdce;line-height:1.5}select,button,input{accent-color:#49c7bd;background:#223142;color:#fff;border:1px solid #526579;border-radius:5px;padding:8px}label{margin-right:16px}.controls{display:flex;gap:12px;align-items:center;flex-wrap:wrap;margin:18px 0}.panels{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.panel{background:#172230;border:1px solid #304256;border-radius:8px;padding:12px}.panel h2{font-size:17px;margin:0 0 8px}canvas{width:100%;display:block;background:#111c29;border-radius:5px}#frame{flex:1;min-width:200px}#info{padding:14px;border-left:3px solid #49c7bd;background:#172230;line-height:1.6}.legend{font-size:14px}.dot{display:inline-block;width:10px;height:10px;border-radius:50%;margin-right:4px}pre{white-space:pre-wrap;color:#bcc9d8}#plot{height:190px;margin-top:12px}@media(max-width:800px){.panels{grid-template-columns:1fr}}
</style>
<h1>Partial observations</h1>
<p>Controlled three-segment motion through SkellyForge’s gap filler and connected window solver. Synthetic reference motion is withheld from fitting. This checks the mechanics; it is not yet a full human-recording validation.</p>
<div class="controls"><label>Case <select id="case"></select></label><label>Projection <select id="projection"><option value="yz">Front · Y/Z</option><option value="xz">Side · X/Z</option><option value="xy">Top · X/Y</option></select></label><label><input type="checkbox" id="truth" checked> Show reference geometry</label></div>
<div class="controls"><button id="play">Play</button><input id="frame" aria-label="Frame" type="range" min="0" max="40" value="19"><output id="time"></output></div>
<div class="legend"><span class="dot" style="background:#65c9ff"></span>Measured <span class="dot" style="background:#ffa94d"></span>Gap-filled <span class="dot" style="background:#68e0ae"></span>Fitted geometry · Grey dashed: reference</div>
<div class="panels"><section class="panel"><h2>1. Raw keypoints</h2><canvas id="raw" width="600" height="520"></canvas></section><section class="panel"><h2>2. Gap-filled solver inputs</h2><canvas id="filled" width="600" height="520"></canvas></section><section class="panel"><h2>3. Complete fitted segments</h2><canvas id="fitted" width="600" height="520"></canvas></section></div>
<p id="info"></p>
<label>Trajectory <select id="point"></select></label><span class="legend"> · vertical coordinate in mm (Z; Y in top view). Click the plot to seek.</span>
<canvas id="plot" width="1200" height="190"></canvas>
<p id="explanation"></p><details><summary>Gap-filling provenance and solver intervals</summary><pre id="report"></pre></details>
<script>
const cases=__DATA__;
const $=id=>document.getElementById(id); let timer=null;
cases.forEach((c,i)=>$('case').add(new Option(c.name,i)));
for(let i=0;i<24;i++)$('point').add(new Option(`Segment ${Math.floor(i/8)+1} · point ${i%8+1}`,i));$('point').value=8;
const explanations=[
'A bounded keypoint gap is interpolated by timestamp before fitting. The other keypoints remain measured. The solver never receives a missing interior sample for this trajectory.',
'All middle-segment keypoints are missing in the same interval. Linear interpolation fills them first. Watch the orange trajectories: interpolation can miss a real bend, and the connected solver cannot recover motion unsupported by the data.',
'Every keypoint is absent in the blank interval. Gap filling stops at its boundaries, and the solver runs separately on either side. Reference geometry is hidden during absence too; the output stays blank.',
'No endpoint extrapolation. Some keypoints can remain missing at the edges while the rest of the model is observed. Whole-recording missing ends stay blank.',
'There is no evidence from which to interpolate this distal segment. Its modeled geometry remains present in the fit. The current solver uses soft rest/temporal priors here; this is not a guarantee of exact rest orientation.'
];
const finite=p=>p&&p.every(v=>v!==null&&Number.isFinite(v));
const edges=[];for(let b=0;b<3;b++)for(let j=0;j<8;j++)for(let bit of [1,2,4])if((j^bit)>j)edges.push([b*8+j,b*8+(j^bit)]);
function draw(){const c=cases[+$('case').value],f=+$('frame').value,axes=$('projection').value==='yz'?[1,2]:$('projection').value==='xz'?[0,2]:[0,1];
 const active=c.fitted[f].some(finite);$('time').textContent=`Frame ${f} · ${c.times[f].toFixed(2)} s`;
 for(const key of ['raw','filled','fitted']){const canvas=$(key),ctx=canvas.getContext('2d'),w=canvas.width,h=canvas.height;ctx.clearRect(0,0,w,h);
  const project=p=>[w/2+p[axes[0]]*.9,h-40-(p[axes[1]]+(axes[1]===1?220:0))*.9];
  function wire(points,color,dash=[]){ctx.strokeStyle=color;ctx.lineWidth=2;ctx.setLineDash(dash);for(const [a,b] of edges){if(!finite(points[a])||!finite(points[b]))continue;ctx.beginPath();ctx.moveTo(...project(points[a]));ctx.lineTo(...project(points[b]));ctx.stroke()}ctx.setLineDash([])}
  if($('truth').checked&&active)wire(c.truth[f],'#617384',[5,5]);
  if(key==='fitted')wire(c[key][f],'#68e0ae');
  c[key][f].forEach((p,i)=>{if(!finite(p))return;ctx.fillStyle=key==='fitted'?'#68e0ae':key==='filled'&&!c.measured[f][i]?'#ffa94d':'#65c9ff';ctx.beginPath();ctx.arc(...project(p),i===+$('point').value?7:3.5,0,2*Math.PI);ctx.fill()});
  if(!c[key][f].some(finite)){ctx.fillStyle='#bcc9d8';ctx.font='22px system-ui';ctx.fillText('No model / no evidence',155,250)}
 }
 const n=c.raw[f].filter(finite).length,nfill=c.filled[f].filter(finite).length;
 $('info').textContent=`This frame: ${n} raw keypoints · ${nfill} prepared keypoints · ${active?'3 complete fitted segments':'blank output'}. Recording: ${c.filled_count} filled samples · ${c.blank_count} blank frames · fitted/reference RMS ${c.rms_mm.toFixed(2)} mm; unmeasured-point RMS ${c.inferred_rms_mm===null?'n/a':c.inferred_rms_mm.toFixed(2)+' mm'}.`;
 $('explanation').textContent=explanations[+$('case').value];$('report').textContent=JSON.stringify({gap_filling:c.report,solver_intervals:c.runs},null,2);
 const cv=$('plot'),ctx=cv.getContext('2d'),p=+$('point').value,axis=axes[1];ctx.clearRect(0,0,cv.width,cv.height);
 const vals=['truth','raw','filled','fitted'].flatMap(k=>c[k].map(fr=>fr[p][axis]).filter(v=>v!==null)),lo=Math.min(...vals)-10,hi=Math.max(...vals)+10;
 const xy=(i,v)=>[40+i/40*(cv.width-60),cv.height-25-(v-lo)/(hi-lo)*(cv.height-45)];
 for(const [k,color] of [['truth','#617384'],['filled','#ffa94d'],['fitted','#68e0ae'],['raw','#65c9ff']]){if(k==='truth'&&!$('truth').checked)continue;ctx.strokeStyle=color;ctx.fillStyle=color;ctx.lineWidth=2;ctx.beginPath();let pen=false;for(let i=0;i<41;i++){const v=c[k][i][p][axis];if(v===null){pen=false;continue}const [x,y]=xy(i,v);if(k==='raw'){ctx.moveTo(x+3,y);ctx.arc(x,y,3,0,2*Math.PI)}else{if(pen)ctx.lineTo(x,y);else ctx.moveTo(x,y);pen=true}}ctx.stroke()}
 ctx.strokeStyle='#fff';ctx.beginPath();ctx.moveTo(xy(f,lo)[0],8);ctx.lineTo(xy(f,lo)[0],cv.height-18);ctx.stroke();ctx.fillStyle='#bac8d8';ctx.font='12px system-ui';ctx.fillText(hi.toFixed(0),0,16);ctx.fillText(lo.toFixed(0),0,cv.height-24);ctx.fillText('0 s',40,cv.height-3);ctx.fillText('2 s',cv.width-30,cv.height-3);
}
for(const id of ['case','frame','projection','truth','point'])$(id).addEventListener('input',draw);
$('play').onclick=()=>{if(timer){clearInterval(timer);timer=null;$('play').textContent='Play'}else{$('play').textContent='Pause';timer=setInterval(()=>{$('frame').value=(+$('frame').value+1)%41;draw()},100)}};
$('plot').onclick=e=>{const r=$('plot').getBoundingClientRect();$('frame').value=Math.round(Math.max(0,Math.min(40,((e.clientX-r.left)/r.width*1200-40)/1140*40)));draw()};
draw();
</script></html>
